# ===== 中秋灯谜答题系统 · 环境变量模板 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交到仓库）

# Gitee 仓库 owner（用户名或组织名），例如：zhangsan
VITE_GITEE_OWNER=

# Gitee 仓库名（必须是已存在的公开仓库），例如：midautumn-riddle-data
VITE_GITEE_REPO=

# Gitee 私人令牌（Personal Access Token），需要 issues 权限
# 生成地址：https://gitee.com/personal_access_tokens
# 勾选权限：projects（仓库读写）/ issues（Issue 读写）
VITE_GITEE_PAT=

# 海报二维码使用的网站地址（部署后改成真实域名；本地开发可留 http://localhost:5173）
VITE_SITE_URL=http://localhost:5173

# 后台管理入口密码（不设置时默认 admin888）
VITE_ADMIN_PASSWORD=admin888

# 活动截止时间（ISO 8601 含时区；到点后自动显示"活动已结束"，不再允许答题）
# 不设置时默认 2026-09-28T00:00:00+08:00（北京时间 9 月 28 日 0 点）
VITE_DEADLINE=2026-09-28T00:00:00+08:00
